#!/usr/bin/expect -f
# Demo for brain-gcd: successful game, then wrong answer

set timeout 10
set script [file normalize [info script]]
set dir [file dirname [file dirname $script]]
cd $dir

proc gcd {a b} {
    while {$b != 0} {
        set t $b
        set b [expr {$a % $b}]
        set a $t
    }
    return $a
}

proc play_correct_rounds {n} {
    for {set i 0} {$i < $n} {incr i} {
        expect -re {Question: (\d+) (\d+)}
        set a $expect_out(1,string)
        set b $expect_out(2,string)
        set answer [gcd $a $b]
        expect "Your answer:"
        send -- "$answer\r"
        expect "Correct!"
    }
}

log_user 0
spawn ./bin/brain-gcd
log_user 1
expect "May I have your name?"
send -- "Tirion\r"
expect "Find the greatest common divisor of given numbers."
play_correct_rounds 3
expect -re {Congratulations, Tirion!}
expect eof
wait

sleep 1

log_user 0
spawn ./bin/brain-gcd
log_user 1
expect "May I have your name?"
send -- "Tirion\r"
expect "Find the greatest common divisor of given numbers."
expect -re {Question: (\d+) (\d+)}
expect "Your answer:"
send -- "0\r"
expect -re {wrong answer}
expect -re {Let's try again, Tirion!}
expect eof
wait
