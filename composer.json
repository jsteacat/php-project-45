{
    "name": "hexlet/code",
    "description": "Brain Games CLI App",
    "license": "MIT",
    "authors": [
        {
            "name": "Stepan Kormilin",
            "email": "ubscoder@gmail.com"
        }
    ],
    "require": {
        "wp-cli/php-cli-tools": "^0.13"
    },
    "autoload": {
        "files": [
            "src/Engine.php",
            "src/Games/Even.php",
            "src/Games/Calc.php",
            "src/Games/GCD.php",
            "src/Games/Progression.php",
            "src/Games/Prime.php"
        ],
        "psr-4": {
            "BrainGames\\": "src"
        }
    },
    "bin": [
        "bin/brain-games",
        "bin/brain-even",
        "bin/brain-calc",
        "bin/brain-gcd",
        "bin/brain-progression",
        "bin/brain-prime"
    ],


    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    }
}